# MongoDB root credentials
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=YOUR_MONGODB_PASSWORD

# FastAPI MongoDB connection
MONGO_URI=mongodb://admin:YOUR_MONGODB_PASSWORD@mongodb:27017/user-account?authSource=admin

# Mongo Express MongoDB connection
ME_CONFIG_MONGODB_URL=mongodb://admin:YOUR_MONGODB_PASSWORD@mongodb:27017/?authSource=admin

# Mongo Express web UI credentials
ME_CONFIG_BASICAUTH_USERNAME=user
ME_CONFIG_BASICAUTH_PASSWORD=YOUR_MONGO_EXPRESS_PASSWORD